{
	"name": "cyriel-basilio-portfolio",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"icons": "node scripts/generate-icons.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"classnames": "^2.5.1",
		"next": "16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.106.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.4.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,mjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,scss,json,md,yml,yaml}": "prettier --write"
	}
}
