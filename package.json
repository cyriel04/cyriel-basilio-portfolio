		"@mui/material-nextjs": "^7.3.7",
		"classnames": "^2.5.1",
		"next": "16.3.8",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sass": "^1.97.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.3.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.4.2",
